{
  "info":{"name":"Activation API - JWT","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[
    {"key":"baseUrl","value":"http://127.0.0.1:8080"},
    {"key":"providerBaseUrl","value":"http://127.0.0.1:9099"},
    {"key":"providerbaseurl","value":"http://127.0.0.1:9099"},
    {"key":"accessToken","value":""},
    {"key":"requestId","value":""}
  ],
  "item":[
    {"name":"Obter token local","request":{"method":"GET","url":"{{providerBaseUrl}}/dev/token?clientId=postman-client&scope=activation%3Aread%20activation%3Awrite%20activation%3Ametrics"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('token emitido', () => pm.response.to.have.status(200));","pm.collectionVariables.set('accessToken', pm.response.json().access_token);","if (pm.environment.name) { pm.environment.set('accessToken', pm.response.json().access_token); }"]}}]},
    {"name":"Criar solicitação","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"externalId\": \"POSTMAN-{{$timestamp}}\",\n  \"customerId\": \"CUST-10001\",\n  \"productCode\": \"INTERNET-500\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/v1/requests"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('criado', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));","pm.environment.set('requestId', pm.response.json().id);"]}}]},
    {"name":"Consultar solicitação","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/requests/{{requestId}}"}},
    {"name":"Listar solicitações","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{accessToken}}"}],"url":"{{baseUrl}}/api/v1/requests?page=0&size=20"}}
  ]
}
